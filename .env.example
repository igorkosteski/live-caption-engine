# Engine selection
ENGINE=soniox

# Source stream
RTMP_URL=rtmp://host.docker.internal/live/stream

# Soniox credentials and model
SONIOX_API_KEY=replace_me
SONIOX_MODEL=stt-rt-preview
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
FFMPEG_PATH=ffmpeg

# Stream resiliency
NO_AUDIO_TIMEOUT_MS=15000
RECONNECT_DELAY_MS=3000
MAX_RETRIES=0

# Optional translation
ENABLE_TRANSLATION=false
TRANSLATION_TYPE=one_way
# BCP-47 source language spoken in the stream; leave empty to auto-detect.
TRANSLATION_SOURCE_LANGUAGE=
# Comma-separated list of target BCP-47 language codes.
# Each language gets its own VTT track and MediaPackage subtitle path.
TRANSLATION_TARGET_LANGUAGES=en

# App server (health and metrics)
PORT=8080
LOG_LEVEL=info

# Live captions (WebVTT + HLS subtitle playlist served locally)
CAPTIONS_ENABLED=true
CAPTIONS_SEGMENT_DURATION_MS=6000
CAPTIONS_WINDOW_SEGMENTS=5
CAPTIONS_BASE_PATH=/captions

# MediaPackage V2 subtitle push
# Set MEDIAPACKAGE_ENABLED=true and fill in the ingest endpoint URL.
# AWS credentials are resolved automatically: env vars → ECS task role → EC2 instance profile.
MEDIAPACKAGE_ENABLED=false
MEDIAPACKAGE_INGEST_URL=https://<endpoint>.mediapackagev2.<region>.amazonaws.com/in/v1/<channelGroup>/<channel>/<ingestEndpoint>
MEDIAPACKAGE_SUBTITLE_PATH=subtitles
# Path for the translated subtitle track (used when ENABLE_TRANSLATION=true)
MEDIAPACKAGE_TRANSLATION_SUBTITLE_PATH=subtitles-translated
AWS_REGION=us-east-1
