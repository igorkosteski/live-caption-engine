# Engine selection
ENGINE=soniox

# Source stream
RTMP_URL=rtmp://host.docker.internal/live/stream

# Soniox credentials and model
SONIOX_API_KEY=replace_me
SONIOX_MODEL=stt-rt-preview
SONIOX_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket

# Audio processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
FFMPEG_PATH=ffmpeg

# Stream resiliency
NO_AUDIO_TIMEOUT_MS=15000
RECONNECT_DELAY_MS=3000
MAX_RETRIES=0

# Optional translation
ENABLE_TRANSLATION=false
TRANSLATION_TYPE=one_way
TRANSLATION_TARGET_LANGUAGE=en

# App server (health and metrics)
PORT=8080
LOG_LEVEL=info

# Live captions (WebVTT + HLS subtitle playlist)
CAPTIONS_ENABLED=true
CAPTIONS_SEGMENT_DURATION_MS=6000
CAPTIONS_WINDOW_SEGMENTS=5
CAPTIONS_BASE_PATH=/captions
