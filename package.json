{
  "name": "live-caption-engine",
  "version": "0.1.0",
  "description": "RTMP live stream transcription service with pluggable engines (Soniox first)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "generate-config": "node scripts/generate-config.js",
    "test": "jest --testPathPattern=tests/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1040.0",
    "@aws-sdk/credential-providers": "^3.1040.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
