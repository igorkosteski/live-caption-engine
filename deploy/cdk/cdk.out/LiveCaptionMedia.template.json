{
 "Description": "Live caption engine — MediaLive + MediaPackage V2 + CloudFront",
 "Resources": {
  "ChannelGroup": {
   "Type": "AWS::MediaPackageV2::ChannelGroup",
   "Properties": {
    "ChannelGroupName": "live-caption",
    "Description": "Live caption engine — receives HLS from MediaLive + VTT/AAC from the caption engine"
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/ChannelGroup"
   }
  },
  "MpChannel": {
   "Type": "AWS::MediaPackageV2::Channel",
   "Properties": {
    "ChannelGroupName": "live-caption",
    "ChannelName": "main",
    "Description": "Main live channel"
   },
   "DependsOn": [
    "ChannelGroup"
   ],
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/MpChannel"
   }
  },
  "HlsEndpoint": {
   "Type": "AWS::MediaPackageV2::OriginEndpoint",
   "Properties": {
    "ChannelGroupName": "live-caption",
    "ChannelName": "main",
    "ContainerType": "TS",
    "HlsManifests": [
     {
      "ManifestName": "index",
      "ManifestWindowSeconds": 60,
      "ProgramDateTimeIntervalSeconds": 1,
      "ScteHls": {
       "AdMarkerHls": "DATERANGE"
      }
     }
    ],
    "OriginEndpointName": "hls",
    "Segment": {
     "IncludeIframeOnlyStreams": false,
     "SegmentDurationSeconds": 6,
     "SegmentName": "seg",
     "TsUseAudioRenditionGroup": true
    },
    "StartoverWindowSeconds": 7200
   },
   "DependsOn": [
    "MpChannel"
   ],
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/HlsEndpoint"
   }
  },
  "MediaLiveRole1149D189": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Effect": "Allow",
       "Principal": {
        "Service": "medialive.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Policies": [
     {
      "PolicyDocument": {
       "Statement": [
        {
         "Action": "mediapackagev2:PutObject",
         "Effect": "Allow",
         "Resource": {
          "Fn::Join": [
           "",
           [
            {
             "Fn::GetAtt": [
              "MpChannel",
              "Arn"
             ]
            },
            "/*"
           ]
          ]
         }
        }
       ],
       "Version": "2012-10-17"
      },
      "PolicyName": "MediaPackageV2Ingest"
     },
     {
      "PolicyDocument": {
       "Statement": [
        {
         "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:DescribeLogStreams",
          "logs:PutLogEvents"
         ],
         "Effect": "Allow",
         "Resource": {
          "Fn::Join": [
           "",
           [
            "arn:aws:logs:us-east-1:",
            {
             "Ref": "AWS::AccountId"
            },
            ":log-group:/aws/medialive/*"
           ]
          ]
         }
        }
       ],
       "Version": "2012-10-17"
      },
      "PolicyName": "CloudWatchLogs"
     },
     {
      "PolicyDocument": {
       "Statement": [
        {
         "Action": [
          "ssm:DescribeParameters",
          "ssm:GetParameter",
          "ssm:GetParameters"
         ],
         "Effect": "Allow",
         "Resource": {
          "Fn::Join": [
           "",
           [
            "arn:aws:ssm:us-east-1:",
            {
             "Ref": "AWS::AccountId"
            },
            ":parameter/medialive*"
           ]
          ]
         }
        }
       ],
       "Version": "2012-10-17"
      },
      "PolicyName": "SsmRead"
     }
    ],
    "RoleName": "live-caption-medialive-role-us-east-1"
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/MediaLiveRole/Resource"
   }
  },
  "InputSg": {
   "Type": "AWS::MediaLive::InputSecurityGroup",
   "Properties": {
    "WhitelistRules": [
     {
      "Cidr": "0.0.0.0/0"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/InputSg"
   }
  },
  "RtmpInput": {
   "Type": "AWS::MediaLive::Input",
   "Properties": {
    "Destinations": [
     {
      "StreamName": "live/primary"
     }
    ],
    "InputSecurityGroups": [
     {
      "Ref": "InputSg"
     }
    ],
    "Name": "live-caption-rtmp",
    "Type": "RTMP_PUSH"
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/RtmpInput"
   }
  },
  "MlChannel": {
   "Type": "AWS::MediaLive::Channel",
   "Properties": {
    "ChannelClass": "SINGLE_PIPELINE",
    "Destinations": [
     {
      "Id": "mp2",
      "Settings": [
       {
        "Url": {
         "Fn::Select": [
          0,
          {
           "Fn::GetAtt": [
            "MpChannel",
            "IngestEndpointUrls"
           ]
          }
         ]
        }
       }
      ]
     }
    ],
    "EncoderSettings": {
     "AudioDescriptions": [
      {
       "AudioSelectorName": "default",
       "AudioTypeControl": "FOLLOW_INPUT",
       "CodecSettings": {
        "AacSettings": {
         "Bitrate": 192000,
         "CodingMode": "CODING_MODE_2_0",
         "InputType": "NORMAL",
         "Profile": "LC",
         "RateControlMode": "CBR",
         "RawFormat": "NONE",
         "SampleRate": 48000,
         "Spec": "MPEG4"
        }
       },
       "LanguageCodeControl": "FOLLOW_INPUT",
       "Name": "audio_aac"
      }
     ],
     "GlobalConfiguration": {
      "InputLossBehavior": {
       "BlackFrameMsec": 1000,
       "InputLossImageColor": "000000",
       "InputLossImageType": "COLOR",
       "RepeatFrameMsec": 900000
      }
     },
     "OutputGroups": [
      {
       "Name": "MediaPackageV2",
       "OutputGroupSettings": {
        "HlsGroupSettings": {
         "Destination": {
          "DestinationRefId": "mp2"
         },
         "HlsCdnSettings": {
          "HlsBasicPutSettings": {
           "ConnectionRetryInterval": 30,
           "FilecacheDuration": 300,
           "NumRetries": 10,
           "RestartDelay": 15
          }
         },
         "InputLossAction": "EMIT_OUTPUT",
         "ManifestCompression": "NONE",
         "ManifestDurationFormat": "FLOATING_POINT",
         "Mode": "LIVE",
         "OutputSelection": "MANIFESTS_AND_SEGMENTS",
         "ProgramDateTime": "INCLUDE",
         "ProgramDateTimePeriod": 1,
         "SegmentLength": 6,
         "SegmentsPerSubdirectory": 10000,
         "StreamInfResolution": "INCLUDE",
         "TimedMetadataId3Frame": "PRIV",
         "TimedMetadataId3Period": 10,
         "TsFileMode": "SEGMENTED_FILES"
        }
       },
       "Outputs": [
        {
         "AudioDescriptionNames": [
          "audio_aac"
         ],
         "OutputName": "hls_720p",
         "OutputSettings": {
          "HlsOutputSettings": {
           "HlsSettings": {
            "StandardHlsSettings": {
             "M3u8Settings": {
              "AudioFramesPerPes": 4,
              "AudioPids": "492-498",
              "EcmPid": "8182",
              "PcrControl": "PCR_EVERY_PES_PACKET",
              "PmtPid": "480",
              "ProgramNum": 1,
              "Scte35Behavior": "NO_PASSTHROUGH",
              "Scte35Pid": "500",
              "TimedMetadataBehavior": "NO_PASSTHROUGH",
              "VideoPid": "481"
             }
            }
           },
           "NameModifier": "_720p"
          }
         },
         "VideoDescriptionName": "video_720p"
        }
       ]
      }
     ],
     "TimecodeConfig": {
      "Source": "EMBEDDED"
     },
     "VideoDescriptions": [
      {
       "CodecSettings": {
        "H264Settings": {
         "AdaptiveQuantization": "HIGH",
         "AfdSignaling": "NONE",
         "Bitrate": 3000000,
         "ColorMetadata": "INSERT",
         "EntropyEncoding": "CABAC",
         "FlickerAq": "ENABLED",
         "ForceFieldPictures": "DISABLED",
         "FramerateControl": "SPECIFIED",
         "FramerateDenominator": 1,
         "FramerateNumerator": 30,
         "GopBReference": "DISABLED",
         "GopClosedCadence": 1,
         "GopNumBFrames": 2,
         "GopSize": 90,
         "GopSizeUnits": "FRAMES",
         "Level": "H264_LEVEL_AUTO",
         "LookAheadRateControl": "HIGH",
         "NumRefFrames": 1,
         "ParControl": "SPECIFIED",
         "ParDenominator": 1,
         "ParNumerator": 1,
         "Profile": "HIGH",
         "RateControlMode": "CBR",
         "ScanType": "PROGRESSIVE",
         "SubgopLength": "FIXED",
         "Syntax": "DEFAULT",
         "TemporalAq": "ENABLED",
         "TimecodeInsertion": "DISABLED"
        }
       },
       "Height": 720,
       "Name": "video_720p",
       "RespondToAfd": "NONE",
       "ScalingBehavior": "DEFAULT",
       "Sharpness": 50,
       "Width": 1280
      }
     ]
    },
    "InputAttachments": [
     {
      "InputAttachmentName": "rtmp-main",
      "InputId": {
       "Ref": "RtmpInput"
      },
      "InputSettings": {
       "AudioSelectors": [],
       "CaptionSelectors": [],
       "DeblockFilter": "DISABLED",
       "DenoiseFilter": "DISABLED",
       "FilterStrength": 1,
       "InputFilter": "AUTO",
       "Smpte2038DataPreference": "IGNORE",
       "SourceEndBehavior": "CONTINUE"
      }
     }
    ],
    "InputSpecification": {
     "Codec": "AVC",
     "MaximumBitrate": "MAX_20_MBPS",
     "Resolution": "HD"
    },
    "Name": "live-caption-channel",
    "RoleArn": {
     "Fn::GetAtt": [
      "MediaLiveRole1149D189",
      "Arn"
     ]
    }
   },
   "DependsOn": [
    "MpChannel"
   ],
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/MlChannel"
   }
  },
  "Oac": {
   "Type": "AWS::CloudFront::OriginAccessControl",
   "Properties": {
    "OriginAccessControlConfig": {
     "Description": "OAC — CloudFront → MediaPackage V2",
     "Name": "live-caption-mp2-oac",
     "OriginAccessControlOriginType": "mediapackagev2",
     "SigningBehavior": "always",
     "SigningProtocol": "sigv4"
    }
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/Oac"
   }
  },
  "Distribution830FAC52": {
   "Type": "AWS::CloudFront::Distribution",
   "Properties": {
    "DistributionConfig": {
     "Comment": "live-caption live stream",
     "DefaultCacheBehavior": {
      "AllowedMethods": [
       "GET",
       "HEAD"
      ],
      "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
      "Compress": false,
      "TargetOriginId": "LiveCaptionMediaDistributionOrigin1B61A0A63",
      "ViewerProtocolPolicy": "redirect-to-https"
     },
     "Enabled": true,
     "HttpVersion": "http2and3",
     "IPV6Enabled": true,
     "Origins": [
      {
       "CustomOriginConfig": {
        "OriginKeepaliveTimeout": 60,
        "OriginProtocolPolicy": "https-only",
        "OriginReadTimeout": 30,
        "OriginSSLProtocols": [
         "TLSv1.2"
        ]
       },
       "DomainName": "live-caption.egress.us-east-1.mediapackagev2.amazonaws.com",
       "Id": "LiveCaptionMediaDistributionOrigin1B61A0A63",
       "OriginAccessControlId": {
        "Fn::GetAtt": [
         "Oac",
         "Id"
        ]
       },
       "OriginPath": "/out/v1/live-caption/main/hls"
      }
     ],
     "PriceClass": "PriceClass_100"
    }
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/Distribution/Resource"
   }
  },
  "EndpointPolicy": {
   "Type": "AWS::MediaPackageV2::OriginEndpointPolicy",
   "Properties": {
    "ChannelGroupName": "live-caption",
    "ChannelName": "main",
    "OriginEndpointName": "hls",
    "Policy": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Sid": "AllowCloudFrontOAC",
       "Effect": "Allow",
       "Principal": {
        "Service": "cloudfront.amazonaws.com"
       },
       "Action": "mediapackagev2:GetObject",
       "Resource": {
        "Fn::GetAtt": [
         "HlsEndpoint",
         "Arn"
        ]
       },
       "Condition": {
        "StringEquals": {
         "AWS:SourceArn": {
          "Fn::Join": [
           "",
           [
            "arn:aws:cloudfront::",
            {
             "Ref": "AWS::AccountId"
            },
            ":distribution/",
            {
             "Ref": "Distribution830FAC52"
            }
           ]
          ]
         }
        }
       }
      }
     ]
    }
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/EndpointPolicy"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/02OUW4CMQxEz8J/NqURPQDaoqpfSHCAKiQGzGbtKHEWVavcHW2QWr7GY2uex2jzYfR6Ze+5c37oAp70fBTrBmXv+WcewaON1g32ApPRc3+m/mqJIHwlLlH9+2XcJ7wg7chHRpKq0I56PnCA5bhoVQ0YcILG+qZY5AiuJJTfP2LbvqCrcoGLPycmabHnn61zkHPPJImD+sQsCU9FkGnJvvpaWwHIXJJrZfZFYpGqiD3oW36bzEa/b/R6dcuIXSokOII+PPUBsMdIDSUBAAA="
   },
   "Metadata": {
    "aws:cdk:path": "LiveCaptionMedia/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "HlsPlaylistUrl": {
   "Description": "HLS master playlist URL — paste into VLC, Quicktime, or an HLS.js player",
   "Value": {
    "Fn::Join": [
     "",
     [
      "https://",
      {
       "Fn::GetAtt": [
        "Distribution830FAC52",
        "DomainName"
       ]
      },
      "/index/index.m3u8"
     ]
    ]
   }
  },
  "MediaPackageIngestUrl": {
   "Description": "MediaPackage V2 primary ingest URL — used by live-caption-engine for VTT/AAC ingest",
   "Value": {
    "Fn::Select": [
     0,
     {
      "Fn::GetAtt": [
       "MpChannel",
       "IngestEndpointUrls"
      ]
     }
    ]
   }
  },
  "MediaLiveChannelId": {
   "Description": "MediaLive channel ID — run: aws medialive start-channel --channel-id <id>",
   "Value": {
    "Ref": "MlChannel"
   }
  },
  "MediaLiveInputId": {
   "Description": "MediaLive input ID — describe to get the RTMP push URL(s)",
   "Value": {
    "Ref": "RtmpInput"
   }
  },
  "MediaLiveInputArn": {
   "Description": "Copy to console or: aws medialive describe-input --input-id <id> to find RTMP URL(s)",
   "Value": {
    "Fn::GetAtt": [
     "RtmpInput",
     "Arn"
    ]
   }
  },
  "CloudFrontDistributionId": {
   "Description": "CloudFront distribution ID",
   "Value": {
    "Ref": "Distribution830FAC52"
   }
  },
  "ExportsOutputFnGetAttMpChannelIngestEndpointUrlsD6F86FC1": {
   "Value": {
    "Fn::Join": [
     "||",
     {
      "Fn::GetAtt": [
       "MpChannel",
       "IngestEndpointUrls"
      ]
     }
    ]
   },
   "Export": {
    "Name": "LiveCaptionMedia:ExportsOutputFnGetAttMpChannelIngestEndpointUrlsD6F86FC1"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}